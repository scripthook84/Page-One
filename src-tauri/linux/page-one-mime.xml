<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-pageone">
    <comment>Page One screenplay</comment>
    <magic priority="80"><match type="string" offset="0" value="PG1"/></magic>
    <glob pattern="*.pageone"/>
    <icon name="page-one"/>
  </mime-type>
  <mime-type type="text/x-fountain">
    <comment>Fountain screenplay</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.fountain"/>
  </mime-type>
  <mime-type type="application/x-fdx">
    <comment>Final Draft screenplay</comment>
    <sub-class-of type="application/xml"/>
    <glob pattern="*.fdx"/>
  </mime-type>
</mime-info>
