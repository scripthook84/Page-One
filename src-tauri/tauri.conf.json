{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Page One",
  "mainBinaryName": "page-one",
  "version": "1.1.0",
  "identifier": "app.pageone.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Page One",
        "width": 1380,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Productivity",
    "publisher": "scripthook84",
    "copyright": "Copyright 2026 scripthook84. Apache License 2.0.",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/scripthook84/Page-One",
    "shortDescription": "Screenwriting software",
    "longDescription": "Page One is a free, open-source app for writing screenplays in industry-standard format.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pageone"
        ],
        "name": "Page One screenplay",
        "description": "Page One screenplay",
        "mimeType": "application/x-pageone",
        "role": "Editor",
        "exportedType": {
          "identifier": "app.pageone.screenplay",
          "conformsTo": [
            "public.data",
            "public.content"
          ]
        }
      }
    ],
    "linux": {
      "deb": {
        "section": "editors",
        "priority": "optional",
        "desktopTemplate": "linux/page-one.desktop",
        "postInstallScript": "linux/postinst",
        "postRemoveScript": "linux/postrm",
        "files": {
          "/usr/share/mime/packages/page-one.xml": "linux/page-one-mime.xml"
        },
        "recommends": [
          "hunspell-en-us"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowSize": {
          "width": 560,
          "height": 340
        },
        "appPosition": {
          "x": 150,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 410,
          "y": 170
        }
      },
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "en-US"
      }
    },
    "resources": {
      "voice/model.onnx": "voice/model.onnx",
      "voice/voices.bin": "voice/voices.bin",
      "voice/voices.json": "voice/voices.json",
      "voice/lexicon.json.gz": "voice/lexicon.json.gz"
    }
  }
}
